# EarthSide environment variables.
#
# Copy this file to:
#   .env.development.local  → used by `npm run dev`   (point Firebase at the DEVELOPMENT project)
#   .env.production.local   → used by `npm run build` / `npm start` (the LIVE project)
# and set the same keys in Vercel (Production → live project, Preview → development project).
# Leaving the Firebase values empty runs the site in demo mode with sample articles.
#
# Everything prefixed NEXT_PUBLIC_ ends up in the browser — never put secrets there.

# "development" | "preview" | "production" — shown in the dashboard so nobody edits the wrong data.
NEXT_PUBLIC_APP_ENV=development
# Public URL of the site (used for SEO, sitemap and social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Firebase (Project settings → General → Your apps → Web app config) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google accounts allowed into /admin, comma separated.
# ⚠️ Must match the email list in firestore.rules (and storage.rules).
NEXT_PUBLIC_ADMIN_EMAILS=earthside.contact@gmail.com,yalif1710@gmail.com

# ── Image uploads: "cloudinary" (free, default) or "firebase" (needs the Blaze plan) ──
NEXT_PUBLIC_IMAGE_PROVIDER=cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# An *unsigned* upload preset. Uploads land in earthside/<APP_ENV>/…
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── Article translation (DeepL, https://www.deepl.com/pro-api) ──
# 🔒 Secret — server-only. Free-plan keys end in ":fx". Empty = translate by hand only.
DEEPL_API_KEY=

# ── Optional: email the team whenever a reader sends a topic request (https://resend.com) ──
# 🔒 Secret — server-only, never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# Without your own domain, Resend only delivers to the email you signed up with.
REQUEST_NOTIFY_EMAIL=earthside.contact@gmail.com
RESEND_FROM=EarthSide <onboarding@resend.dev>

# ── Optional: Cloudflare Turnstile anti-spam on the request form ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# 🔒 Secret
TURNSTILE_SECRET_KEY=
