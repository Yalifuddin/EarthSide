# Copy this file to `.env.local` and fill in the values.
# Leaving the Firebase values empty runs the site in demo mode with sample articles.

# Public URL of the deployed site (used for SEO / social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Firebase (Project settings → General → Your apps → Web app config) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google accounts allowed into /admin (dashboard login), comma separated.
# ⚠️ Must match the email list in firestore.rules (and storage.rules).
NEXT_PUBLIC_ADMIN_EMAILS=earthside.contact@gmail.com,yalif1710@gmail.com

# ── Image uploads: "cloudinary" (free, default) or "firebase" (needs the Blaze plan) ──
NEXT_PUBLIC_IMAGE_PROVIDER=cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── Optional: email Della whenever a reader sends a topic request (https://resend.com) ──
# Server-only secret: never prefix it with NEXT_PUBLIC_.
RESEND_API_KEY=
# Without your own domain, Resend only delivers to the email you signed up with.
REQUEST_NOTIFY_EMAIL=earthside.contact@gmail.com
RESEND_FROM=EarthSide <onboarding@resend.dev>

# ── Optional: Cloudflare Turnstile anti-spam on the request form ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
